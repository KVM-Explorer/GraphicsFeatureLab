		<pass name="SSAO" type="shader" active="true" patchverts="1">
			<shader type="vs" path="shaders\SSAOVS.hlsl" entry="main" />
			<shader type="ps" path="shaders\SSAOPS.hlsl" entry="main" />
			<inputlayout>
				<item value="Position" semantic="POSITION" />
			</inputlayout>
			<rendertexture name="ssaoRT" />
			<items>
				<item name="ScreenQuad" type="geometry">
					<type>ScreenQuadNDC</type>
					<width>1</width>
					<height>1</height>
